# Optional provider overrides.
# RoutePilot works out-of-the-box with OpenStreetMap-based public demo services.
# If you later add a provider requiring a key, keep the key here and NEVER commit .env.

VITE_GEOCODER_URL=https://photon.komoot.io/api/
VITE_ROUTING_URL=https://router.project-osrm.org/route/v1/driving